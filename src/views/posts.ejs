<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - Posts</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav>
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 30px;">
    <h4 class="section-title">Feed de Posts</h4>

    <div class="row" style="margin-top: 20px;">
      <% if (posts.length === 0) { %>
        <p class="center-align" style="color: var(--text-muted);">No hay posts todavía. Sé el primero en publicar.</p>
      <% } else { %>
        <% posts.forEach(post => { %>
          <div class="col s12 m6 l4">
            <div class="card">
              <% if (post.imageUrl) { %>
                <div class="card-image">
                  <img src="<%= post.imageUrl %>" alt="Imagen del post">
                </div>
              <% } %>
              <div class="card-content">
                <span class="card-title"><%= post.title %></span>
                <p><%= post.content %></p>
                <p>
                  <% (post.hashtags || []).forEach(tag => { %>
                    <span class="chip">#<%= tag %></span>
                  <% }) %>
                </p>
              </div>
              <div class="card-action">
                <div class="right">
                  <a href="/posts/<%= post._id %>/edit" class="btn-flat">
                    <i class="material-icons">edit</i>
                  </a>
                  <form action="/posts/<%= post._id %>/delete" method="POST" style="display: inline;">
                    <button type="submit" class="btn-flat" style="border: none; background: none;">
                      <i class="material-icons red-text">delete</i>
                    </button>
                  </form>
                </div>
                <div class="author-row">
                  <div class="avatar-ring">
                    <span><%= post.user ? post.user.name.charAt(0).toUpperCase() : "?" %></span>
                  </div>
                  <span style="font-size: .85rem;"><%= post.user ? post.user.name + " " + post.user.lastName : "Desconocido" %></span>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <a href="/posts/new" class="fab-new-post">
    <i class="material-icons">add</i>
  </a>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>