<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Post</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav>
    <div class="nav-wrapper container">
      <a href="/posts" class="brand-logo">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 40px; max-width: 600px;">
    <div class="card-panel">
      <h5 class="section-title" style="font-size: 1.4rem;">Editar Post</h5>
      <form action="/posts/<%= post._id %>/update" method="POST" style="margin-top: 20px;">
        <div class="input-field">
          <input id="title" type="text" name="title" minlength="5" maxlength="30" value="<%= post.title %>" required>
          <label for="title" class="active">Título</label>
        </div>
        <div class="input-field">
          <textarea id="content" class="materialize-textarea" name="content" minlength="10" required><%= post.content %></textarea>
          <label for="content" class="active">Contenido</label>
        </div>
        <div class="input-field">
          <input id="imageUrl" type="url" name="imageUrl" value="<%= post.imageUrl || '' %>">
          <label for="imageUrl" class="active">URL de imagen</label>
        </div>
        <div class="input-field">
          <input id="hashtags" type="text" name="hashtags" value="<%= (post.hashtags || []).join(', ') %>">
          <label for="hashtags" class="active">Hashtags (separados por coma)</label>
        </div>
        <button type="submit" class="btn waves-effect waves-light">Guardar cambios</button>
        <a href="/posts" class="btn grey waves-effect waves-light">Cancelar</a>
      </form>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>